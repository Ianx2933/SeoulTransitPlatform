# Copy this file to .env for local development.
# Never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/Seoul_Transit
DB_USERNAME=postgres
DB_PASSWORD=change-me

ADMIN_API_TOKEN=local-dev-token
PREDICTION_SERVICE_BASE_URL=http://localhost:5000
SEOUL_BUS_API_KEY=

# Redis is the default cache provider.
CACHE_TYPE=redis
CACHE_TTL=10m
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=3s

# Optional lightweight local mode without Redis.
# SPRING_PROFILES_ACTIVE=local-simple
