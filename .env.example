# Copy this file to .env for local development.
# Never commit real secrets.
# (로컬 개발용으로 .env에 복사해서 사용하세요. 실제 값은 커밋 금지.)

# --- Database ---------------------------------------------------------------
# DB_URL is used when running the API server directly on the host.
# docker-compose overrides it with the container hostname.
DB_URL=jdbc:postgresql://localhost:5432/Seoul_Transit
DB_USERNAME=postgres
DB_PASSWORD=change-me

POSTGRES_DB=Seoul_Transit
POSTGRES_USER=postgres

# Pipeline scripts read this instead of taking a --db-url argument.
# (파이프라인 스크립트가 --db-url 대신 이 값을 읽습니다.)
PIPELINE_DB_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/Seoul_Transit

# --- API server -------------------------------------------------------------
ADMIN_API_TOKEN=local-dev-token
PREDICTION_SERVICE_BASE_URL=http://localhost:5000
SEOUL_BUS_API_KEY=

# --- Cache ------------------------------------------------------------------
CACHE_TYPE=redis
CACHE_TTL=10m
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=3s

# Optional lightweight local mode without Redis.
# SPRING_PROFILES_ACTIVE=local-simple

# --- Airflow (only needed for the airflow profile) --------------------------
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_PASSWORD=admin
# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=
# Optional. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Seoul Open Data API ----------------------------------------------------
SEOUL_HOURLY_API_KEY=
SEOUL_DAILY_API_KEY=
